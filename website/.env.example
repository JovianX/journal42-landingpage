# Microsoft Clarity project ID (heatmaps + session recordings)
# Defaults to xs7ris3ik0 if unset in production.
VITE_CLARITY_PROJECT_ID=xs7ris3ik0

# Google Tag Manager container ID
# Defaults to GTM-54LV3C2T if unset in production.
VITE_GTM_ID=GTM-54LV3C2T

# Google Analytics 4 measurement ID
# Defaults to G-XL5NMZ418L if unset in production.
VITE_GA_MEASUREMENT_ID=G-XL5NMZ418L

# Meta (Facebook) Pixel ID from Events Manager
# Defaults to 1957935677758041 if unset in production.
VITE_META_PIXEL_ID=1957935677758041

# Journal42 app origin for CTAs (login + checkout)
# Dev default: http://localhost:5174 (app)
# Website/landing runs on http://localhost:5173
# Prod default: https://app.journal42.cloud
# VITE_APP_URL=

# Reflection API for hero "Reflect" on typed text
# Dev default: http://localhost:8787
# Prod default: https://api.journal42.cloud
# VITE_AI_API_BASE=
